FROM python:3.12-slim

# The app resolves frontend/ and storage/ relative to its own location, so the
# image mirrors the repo layout: /app/backend (code, cwd) and /app/frontend, /app/storage.
WORKDIR /app/backend

# All dependencies ship as binary wheels, so no compiler or system packages are needed.

# Copy requirements first for better caching
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY backend/app ./app
COPY backend/alembic ./alembic
COPY backend/alembic.ini ./alembic.ini
COPY frontend /app/frontend

# Create storage directories (/app/storage is mounted from ./storage by docker-compose)
RUN mkdir -p /app/storage/uploads /app/storage/models /app/storage/reports /app/storage/temp /app/backend/logs

# Expose port
EXPOSE 8000

# Apply migrations, then start the API
CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000"]
