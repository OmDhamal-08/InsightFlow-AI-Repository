# Keep the Docker build context small: only backend/ and frontend/ code is copied
# explicitly by docker/Dockerfile.backend, but the context is still sent in full.
.git
.github
**/venv/
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/*.pyc
**/logs/
**/*.log
**/*.db
**/.env
storage/uploads/*
storage/models/*
storage/reports/*
storage/temp/*
node_modules/
