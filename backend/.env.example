# Copy to backend/.env and adjust. All values have safe defaults for local development.
APP_NAME=AI BI Platform
DEBUG=true

# SQLite works out of the box. For PostgreSQL use:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_bi_platform
DATABASE_URL=sqlite+aiosqlite:///./ai_bi_platform.db

# Generate a real key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=["http://localhost:8000"]
UPLOAD_DIR=../storage/uploads
MODELS_DIR=../storage/models
MAX_UPLOAD_SIZE=104857600

# AutoML: rows above this are down-sampled; ML_N_JOBS=-1 uses all CPU cores
AUTOML_MAX_ROWS=50000
ML_N_JOBS=1

LOG_LEVEL=INFO
